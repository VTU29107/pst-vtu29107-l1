import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int T = sc.nextInt();
        while (T-- > 0) {
            String s = sc.next();
            int[] left = new int[26];
            int[] right = new int[26];

            int n = s.length();
            int mid = n / 2;
            for (int i = 0; i < mid; i++) {
                left[s.charAt(i) - 'a']++;
            }
            for (int i = (n + 1) / 2; i < n; i++) {
                right[s.charAt(i) - 'a']++;
            }

            System.out.println(Arrays.equals(left, right) ? "YES" : "NO");
        }

        sc.close();
    }
}
